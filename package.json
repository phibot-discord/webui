{
	"name": "phi-webui",
	"version": "0.1.0",
	"license": "GPL-3.0-only",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"codegen": "node scripts/codegen.mjs",
		"dev": "node scripts/codegen.mjs && next dev",
		"build": "node scripts/codegen.mjs && next build",
		"dev:local": "node scripts/codegen.mjs && PHI_LOCAL_DATA=1 CLOUDFLARE_R2_BUCKET=off CLOUDFLARE_R2_PUBLIC_BASE=${CLOUDFLARE_R2_PUBLIC_BASE:-https://r2.phibot.dev} next dev",
		"render-card": "node scripts/codegen.mjs && node --import tsx scripts/render-card-local.ts",
		"start": "next start",
		"typecheck": "node scripts/codegen.mjs && next typegen && tsc --noEmit",
		"test": "node scripts/codegen.mjs && node --import tsx --test 'src/**/*.test.ts'",
		"fmt": "biome format --write",
		"drawings": "node tools/drawings/build.mjs"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@takumi-rs/core": "2.19.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"jszip": "^3.10.2",
		"mediabunny": "^1.65.0",
		"nanoid": "^6.0.2",
		"next": "^16.4.4",
		"next-auth": "5.0.0-beta.32",
		"qrcode": "^1.5.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sharp": "^0.35.5",
		"takumi-js": "^2.19.0",
		"undici": "^8.12.3",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"art-template": "^4.13.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
