<!DOCTYPE html>
<html lang="{{lang || 'zh-cn'}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <link rel="shortcut icon" href="#" />
    <link rel="stylesheet" type="text/css" href="{{_res_path}}html/common/common.css" />

    {{block 'css'}}
    {{/block}}

    <title>phi</title>
</head>

<body class="elem-{{element || elem || `hydro`}} {{displayMode || mode || `default`}}-mode  {{bodyClass}}" {{@sys.scale}}>


    <div class="background theme-background">
        {{if theme == "star"}}
        <img class="star-base" src="{{_res_path}}html/otherimg/Star1.png" alt="曲绘-模糊">
        <img class="star-overlay" src="{{_res_path}}html/otherimg/Star2.png" alt="曲绘-模糊"
            style="min-height: 0;width: 100%;height: auto;bottom: 0">
        {{else}}
        {{if background}}
        <img class="star-base" src="{{background}}" alt="曲绘-模糊">
        {{else}}
        <img class="star-base" src="{{_res_path}}html/otherimg/phigros.png" alt="曲绘-模糊">
        {{/if}}
        {{/if}}
    </div>

    {{block 'main'}}{{/block}}
{{block 'foot'}}{{/block}}</body>

</html>
