{{extend defaultLayout}}

{{block 'css'}}
<link rel="stylesheet" href="{{_res_path}}html/b19/b19.css">
<link rel="stylesheet" href="phi-css://knobs.css">
<link rel="stylesheet" href="phi-css://takumi.css">
<link rel="stylesheet" href="phi-css://player.css">
<link rel="stylesheet" href="phi-css://b30.css">
{{/block}}

{{block 'main'}}

<div class="title">
    <div class="playerInfo">
        <div class="blackBlock clip-box"></div>
        <div class="playerId">
            <p name="pvis"{{if nameStyle}} style="{{nameStyle}}"{{/if}}>{{#gameuser.PlayerId}}</p>
        </div><div class="rks clip-box">
            <p>{{gameuser.rks.toFixed(4)}}{{if rksStddev > 0}} <span class="rks-sd">±{{rksStddev.toFixed(2)}}</span>{{/if}}</p>
        </div><div class="avatar clip-box">
            <img src="{{_res_path}}html/avatar/{{gameuser.avatar}}.png" alt="{{gameuser.avatar}}">
        </div>
        <div class="clgBox">
            <div class="Challenge">
            <img src="{{_res_path}}html/otherimg/{{gameuser.ChallengeMode}}.png" alt="Challenge">
            <p>{{gameuser.ChallengeModeRank}}</p>
            </div>
        </div>
        <div class="date">
            <p>{{Date}}</p>
        </div>
        <div class="dataBox clip-box">
            <img src="{{_res_path}}html/otherimg/data.png" alt="data">
            <p>{{gameuser.data}}</p>
        </div>
        {{if spInfo}}
        <div class="spInfoBox">
            {{each spInfo v}}
            <div class="spInfo colorful-background clip-box">
                <p>{{v}}</p>
            </div>
            {{/each}}
        </div>
        {{/if}}
    </div>
    {{if hideRecordStats !== true}}
    <div class="recordInfo clip-box">
        <div class="whiteLine clip-box"></div>
        <div class="stats-table">{{each statsTable.rows row r}}<div class="stats-row stats-row-{{r}}" style="position:relative;height:24px;width:{{statsTable.width}}px">{{each row cell c}}<div class="stats-{{c ? 'val' : 'lab'}}" style="position:absolute;left:{{c ? statsTable.labW + (c - 1) * statsTable.valW : 0}}px;top:0;width:{{c ? statsTable.valW : statsTable.labW}}px;height:24px;display:flex;justify-content:center;align-items:center;text-align:center;box-sizing:border-box">{{@cell}}</div>{{/each}}</div>{{/each}}</div>
    </div>
    {{/if}}
</div>
<div class="b19">
    {{if phi}}

    {{each phi song}}

    {{if song}}


    <div class="song phi_song">
        <div class="ill-box">
            <div class="num clip-box">
                <p name="pvis">P{{$index+1}}</p>
            </div>
            <div class="ill clip-box">
                <img src="{{song.illustration}}" alt="ill">
            </div>
            <div class="rank-{{song.rank}} clip-box">
                <div class="org">
                    <p>{{song.rank}}&nbsp;{{song.difficulty.toFixed(1)}}</p>
                </div>
                <div class="rel">
                    <p>{{song.rks.toFixed(4)}}</p>
                </div>
            </div>
        </div>
        <div class="info-{{song.rank}}">{{if song.fit.mid}}<div class="info-mid">{{/if}}
            <div class="songname{{if song.fit.lines}} songname-wrap{{/if}}">{{if song.fit.lines}}{{each song.fit.lines line}}<p name="pvis" style="font-size:{{song.fit.px}}px">{{line}}</p>{{/each}}{{else}}<p name="pvis" style="font-size:{{song.fit.px}}px">{{song.song}}</p>{{/if}}
            </div>
            <div class="songinfo"><div class="chengji"><div class="score-line"><div class="Rating">
                    <img src="{{_res_path + 'html/otherimg/' + song.Rating + '.png'}}" alt="{{song.Rating}}">
                </div><div class="score">
                        <p>{{song.score}}</p>
                    </div></div>
                    <div class="line"></div>
                    <div class="acc-box">
                        <div class="acc">
                            <p>{{song.acc.toFixed(4)}}%</p>
                        </div>
                        <div class="suggest suggest-kind-{{song.suggestType}}">
                            <div class="suggest-tip"></div>
                            <p>{{song.suggest}}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>{{if song.fit.mid}}</div>{{/if}}
        {{if song.accRanks && song.accRanks.length}}
        <div class="accRanks">
            {{each song.accRanks r}}
            <div class="accAvg {{if r.fit.px != 12}}rank-px-{{r.fit.px}} {{/if}}accRank{{if r.ap}} accRankAp{{/if}}{{if r.scope == 'band'}} accRankBand{{/if}} clip-box">
                <div class="accAvgLine clip-box"></div>
                {{if r.tag}}<p class="accRankTag">{{r.tag}}</p>{{/if}}{{if r.show != 'percent'}}<p class="accRankPos">{{r.pos}}</p>{{if r.fit.of}}<p class="accRankOf">{{r.of}}</p>{{/if}}{{/if}}{{if r.show != 'place'}}<p class="accRankPct{{if r.show == 'percent'}} accRankLead{{/if}}">{{r.pct}}</p>{{/if}}
            </div>
            {{/each}}
        </div>
        {{else if song.accAvg}}
        <div class="accAvg acc{{song.accKind}}{{if song.accRank && song.accRank.ap}} accRankAp{{/if}} clip-box">
            <div class="accAvgLine clip-box"></div>
            {{if song.accRank}}
            <p class="accRankPos">{{song.accRank.pos}}</p><p class="accRankOf">{{song.accRank.of}}</p><p class="accRankPct">{{song.accRank.pct}}</p>
            {{else}}
            <svg viewBox="0 0 1024 1024">
            {{if song.accKind == 'Finished'}}
            <path
            d="M892.064 261.888a31.936 31.936 0 0 0-45.216 1.472L421.664 717.248l-220.448-185.216a32 32 0 1 0-41.152 48.992l243.648 204.704a31.872 31.872 0 0 0 20.576 7.488 31.808 31.808 0 0 0 23.36-10.112L893.536 307.136a32 32 0 0 0-1.472-45.248z"
            p-id="5526"
            ></path>
            {{else}}
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            {{/if}}
            </svg>
            <p>{{song.accAvg}}</p>
            {{/if}}
        </div>
        {{/if}}
        {{if song.cpToOld}}
        <div class="cpToOld acc{{song.cpToOld.type}} clip-box-left">
            <p>Dif</p>
            <svg viewBox="0 0 1024 1024">
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            </svg>
            <p>{{song.cpToOld.dif}}&nbsp;&nbsp;&nbsp;RKS</p>
            <svg viewBox="0 0 1024 1024">
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            </svg>
            <p>{{song.cpToOld.rks}}</p>
        </div>
        {{/if}}
    </div>

    {{else}}

    <div class="Nosignal">
        <div class="border_corner border_corner_left_top"></div>
        <div class="border_corner border_corner_right_top"></div>
        <div class="border_corner border_corner_left_bottom"></div>
        <div class="border_corner border_corner_right_bottom"></div>
        <div class="line"></div>
        <div class="timeout">
            <p>TIME_OUT</p>
        </div>
        <div class="client">
            <p>>>> PhigrOS Client Finding Phi.score</p>
        </div>
        <div class="sqrt"></div>
    </div>

    {{/if}}

    {{/each}}

    {{/if}}


    {{each b19_list song}}
    
    {{if $index == (phi ? 27 : 30)}}
    <div class="over_flow">
        <div class="flow_line_box_l">
            <div class="flow_line" style="width:50%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:25%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:12.5%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:6.25%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:3.125%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:1.5625%;flex:none;height:15px;background:#ffffff"></div></div>
        <p><i>OVER FLOW</i></p>
        <div class="flow_line_box_r">
            <div class="flow_line" style="width:1.5625%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:3.125%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:6.25%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:12.5%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:25%;flex:none;height:15px;background:#ffffff"></div>
            <div class="flow_line" style="width:50%;flex:none;height:15px;background:#ffffff"></div></div>
    </div>
    {{/if}}


    <div class="song {{$index < (phi ? 27 : 30) ? 'b_song':''}}">
        <div class="ill-box">
            <div class="num clip-box">
                <p name="pvis">#{{song.num}}</p>
            </div>
            <div class="ill clip-box">
                <img src="{{song.illustration}}" alt="ill">
            </div>
            <div class="rank-{{song.rank}} clip-box">
                <div class="org">
                    <p>{{song.rank}}&nbsp;{{song.difficulty.toFixed(1)}}</p>
                </div>
                <div class="rel">
                    <p>{{song.rks.toFixed(4)}}</p>
                </div>
            </div>
        </div>
        <div class="info-{{song.rank}}">{{if song.fit.mid}}<div class="info-mid">{{/if}}
            <div class="songname{{if song.fit.lines}} songname-wrap{{/if}}">{{if song.fit.lines}}{{each song.fit.lines line}}<p name="pvis" style="font-size:{{song.fit.px}}px">{{line}}</p>{{/each}}{{else}}<p name="pvis" style="font-size:{{song.fit.px}}px">{{song.song}}</p>{{/if}}
            </div>
            <div class="songinfo"><div class="chengji"><div class="score-line"><div class="Rating">
                    <img src="{{_res_path + 'html/otherimg/' + song.Rating + '.png'}}" alt="{{song.Rating}}">
                </div><div class="score">
                        <p>{{song.score}}</p>
                    </div></div>
                    <div class="line"></div>
                    <div class="acc-box">
                        <div class="acc">
                            <p>{{song.acc.toFixed(4)}}%</p>
                        </div>
                        <div class="suggest suggest-kind-{{song.suggestType}}">
                            <div class="suggest-tip"></div>
                            <p>{{song.suggest}}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>{{if song.fit.mid}}</div>{{/if}}
            
        {{if song.accRanks && song.accRanks.length}}
        <div class="accRanks">
            {{each song.accRanks r}}
            <div class="accAvg {{if r.fit.px != 12}}rank-px-{{r.fit.px}} {{/if}}accRank{{if r.ap}} accRankAp{{/if}}{{if r.scope == 'band'}} accRankBand{{/if}} clip-box">
                <div class="accAvgLine clip-box"></div>
                {{if r.tag}}<p class="accRankTag">{{r.tag}}</p>{{/if}}{{if r.show != 'percent'}}<p class="accRankPos">{{r.pos}}</p>{{if r.fit.of}}<p class="accRankOf">{{r.of}}</p>{{/if}}{{/if}}{{if r.show != 'place'}}<p class="accRankPct{{if r.show == 'percent'}} accRankLead{{/if}}">{{r.pct}}</p>{{/if}}
            </div>
            {{/each}}
        </div>
        {{else if song.accAvg}}
        <div class="accAvg acc{{song.accKind}}{{if song.accRank && song.accRank.ap}} accRankAp{{/if}} clip-box">
            <div class="accAvgLine clip-box"></div>
            {{if song.accRank}}
            <p class="accRankPos">{{song.accRank.pos}}</p><p class="accRankOf">{{song.accRank.of}}</p><p class="accRankPct">{{song.accRank.pct}}</p>
            {{else}}
            <svg viewBox="0 0 1024 1024">
            {{if song.accKind == 'Finished'}}
            <path
            d="M892.064 261.888a31.936 31.936 0 0 0-45.216 1.472L421.664 717.248l-220.448-185.216a32 32 0 1 0-41.152 48.992l243.648 204.704a31.872 31.872 0 0 0 20.576 7.488 31.808 31.808 0 0 0 23.36-10.112L893.536 307.136a32 32 0 0 0-1.472-45.248z"
            p-id="5526"
            ></path>
            {{else}}
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            {{/if}}
            </svg>
            <p>{{song.accAvg}}</p>
            {{/if}}
        </div>
        {{/if}}
        {{if song.cpToOld}}
        <div class="cpToOld acc{{song.cpToOld.type}} clip-box-left">
            <p>Dif</p>
            <svg viewBox="0 0 1024 1024">
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            </svg>
            <p>{{song.cpToOld.dif}}&nbsp;&nbsp;&nbsp;RKS</p>
            <svg viewBox="0 0 1024 1024">
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            </svg>
            <p>{{song.cpToOld.rks}}</p>
        </div>
        {{/if}}
    </div>

    {{/each}}

</div>
{{if b30Analysis}}
<div class="over_flow">
    <div class="flow_line_box_l">
        <div class="flow_line" style="width:50%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:25%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:12.5%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:6.25%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:3.125%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:1.5625%;flex:none;height:15px;background:#ffffff"></div></div>
    <p><i>{{t.analysisTitle}}</i></p>
    <div class="flow_line_box_r">
        <div class="flow_line" style="width:1.5625%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:3.125%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:6.25%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:12.5%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:25%;flex:none;height:15px;background:#ffffff"></div>
        <div class="flow_line" style="width:50%;flex:none;height:15px;background:#ffffff"></div></div>
</div>

<div class="b30-analysis-row {{if b30Analysis.histogramWide}}histogram-wide{{/if}}">
    {{if b30Analysis.showTags}}
    <section class="analysis-panel tag-analysis-panel clip-box">
        <div class="analysis-panel-head">
            <div>
                <p class="analysis-kicker">CHART PROFILE</p>
                <p class="analysis-title">{{t.tagAbility}}</p>
            </div>
            <p class="analysis-meta">{{b30Analysis.tagMeta}}</p>
        </div>
        <div class="tag-analysis-body {{if !b30Analysis.tagAnalysis || b30Analysis.tagAnalysis.insufficient}}is-insufficient{{/if}}">
            <div class="tag-analysis-content">
                <div class="tag-radar-column">
                    <div class="tag-radar-title"><span></span><p>{{t.categorySummary}}</p></div>
                    {{if b30Analysis.radarHtml}}
                    {{@ b30Analysis.radarHtml}}
                    {{/if}}
                </div>
                <div class="tag-ranking-column">
                    <div class="tag-ranking-group strong-tags">
                        <div class="tag-column-title"><span></span><p>{{t.strongTags}}</p></div>
                        {{if b30Analysis.tagAnalysis}}
                        {{each b30Analysis.tagAnalysis.strong tag}}
                        <div class="tag-result-row{{if tag.faint}} is-faint{{/if}}">
                            <p class="tag-rank">{{$index + 1}}</p>
                            <p class="tag-name">{{tag.name}}</p>
                            <p class="tag-rks{{if tag.slight}} is-slight{{/if}}">{{tag.shown}}</p>
                        </div>
                        {{/each}}
                        {{/if}}
                    </div>
                    <div class="tag-ranking-group weak-tags">
                        <div class="tag-column-title"><span></span><p>{{t.weakTags}}</p></div>
                        {{if b30Analysis.tagAnalysis}}
                        {{each b30Analysis.tagAnalysis.weak tag}}
                        <div class="tag-result-row{{if tag.faint}} is-faint{{/if}}">
                            <p class="tag-rank">{{$index + 1}}</p>
                            <p class="tag-name">{{tag.name}}</p>
                            <p class="tag-rks{{if tag.slight}} is-slight{{/if}}">{{tag.shown}}</p>
                        </div>
                        {{/each}}
                        {{/if}}
                    </div>
                </div>
            </div>
            {{if !b30Analysis.tagAnalysis || b30Analysis.tagAnalysis.insufficient}}
            <div class="tag-insufficient-message">
                <p>{{b30Analysis.tagMessage}}</p>
            </div>
            {{/if}}
        </div>
        {{if b30Analysis.tagAnalysis && !b30Analysis.tagAnalysis.insufficient}}
        <div class="tag-analysis-tip">
            {{if b30Analysis.tagPoolNote}}
            <p>{{b30Analysis.tagPoolNote}}</p>
            {{/if}}
            <p>{{t.tagTip}}</p>
        </div>
        {{/if}}
    </section>
    {{/if}}

    <section class="analysis-panel histogram-panel clip-box">
        <div class="analysis-panel-head">
            <div>
                <p class="analysis-kicker">RKS DISTRIBUTION</p>
                <p class="analysis-title">{{t.histTitle}}</p>
            </div>
            <div class="histogram-summary" style="text-align:right;flex:none;min-width:140px"><p class="histogram-avg-label" style="font-size:12px;color:rgba(255,255,255,0.75)">{{t.avgRks}}</p><p style="font-size:24px;color:#ffffff;font-family:Aldrich,PHI">{{b30Analysis.histogram.average.toFixed(4)}}</p></div>
        </div>
        <div class="histogram-chart" style="position:relative;width:100%;height:178px;padding-top:8px;overflow:hidden">
            <div class="histogram-plot" style="position:relative;width:100%;height:164px;overflow:hidden">
                <div class="histogram-y-ticks" style="position:absolute;left:0;top:0;width:40px;height:136px">
                    {{each hist.ticks tick}}
                    <p class="histogram-y-tick" style="position:absolute;right:2px;bottom:{{tick.bottom}}px;margin:0;padding:0;width:36px;text-align:right;white-space:nowrap;font-size:10px;line-height:1;color:rgba(255,255,255,0.75)">{{tick.label}}</p>
                    {{/each}}
                </div>
                <div class="histogram-y-label" style="position:absolute;left:0;top:136px;width:40px;height:28px;display:flex;flex-direction:column;justify-content:center;align-items:flex-end;overflow:visible;writing-mode:horizontal-tb;font-size:8px;line-height:1.15;color:rgba(255,255,255,0.52)">{{each hist.yTitle part}}<span>{{@part}}</span>{{/each}}</div>
                <div class="histogram-scale" style="position:absolute;left:40px;right:0;top:0;height:136px;box-sizing:content-box">
                    {{each hist.ticks tick}}
                    <div class="histogram-grid-line" style="position:absolute;left:0;right:0;bottom:{{tick.bottom}}px;border-top:1px dashed rgba(255,255,255,0.28)"></div>
                    {{/each}}
                    <div class="average-marker" style="position:absolute;left:0;right:0;bottom:{{hist.avgBottom}}px;height:2px;background:#ffffff"><p style="position:absolute;top:-14px;right:4px;margin:0;padding:0;white-space:nowrap;font-size:9px;line-height:1;color:#ffffff">AVG {{b30Analysis.histogram.average.toFixed(4)}}</p></div>
                </div>
                <div class="histogram-bars" style="position:absolute;left:40px;right:3px;top:0;height:164px;display:flex;flex-direction:row;align-items:stretch">
                    {{each hist.slots slot}}
                    <div class="histogram-slot">
                        <div class="histogram-bar-area">
                            <div class="histogram-bar {{slot.bar}}" style="height:{{slot.height}}px;width:72%;min-height:3px"></div>
                        </div>
                        <p class="histogram-slot-label" style="display:flex;flex-direction:column;align-items:center;justify-content:flex-start;height:24px;width:100%;font-size:7px;line-height:1;margin:0;padding:2px 0 0;transform:none">{{if slot.label.length > 1}}{{each slot.label part}}<span>{{@part}}</span>{{/each}}{{else}}{{@slot.label[0]}}{{/if}}</p>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>
        <div class="histogram-legend">
            {{if b30Analysis.histogramPhiSlots}}
            <p><span class="legend-dot phi-dot"></span>P1-P3</p>
            {{/if}}
            <p><span class="legend-dot best-dot"></span>B1-B27</p>
            <p>{{b30Analysis.histogram.count}}{{t.histSlotsUnit}}</p>
        </div>
    </section>
</div>
{{/if}}

{{/block}}

{{block 'foot'}}{{if tips.trim()}}<div class="tips"><p>Tip:{{tips}}</p></div>{{/if}}{{/block}}
