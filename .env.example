AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=http://localhost:3000
# Extra origins so Discord OAuth returns to the host the user started on:
AUTH_URLS=https://phi.yuemiyuki.dev,https://phi-webui.vercel.app
AUTH_TRUST_HOST=true

# Cloudflare KV namespace shared with the Discord bot (same phi:* keys)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Defaults to ./phi-assets (HTML, fonts, song info)
# PHI_ASSETS=/absolute/path/to/phi-assets
# PHI_ILL=/absolute/path/to/illustration-pack

CLOUDFLARE_R2_BUCKET=phi-web-assets
# CLOUDFLARE_R2_ILL_PREFIX=original_ill
# CLOUDFLARE_R2_HTML_PREFIX=html
# CLOUDFLARE_R2_INFO_PREFIX=info
# Public R2 custom domain (TLS 1.3). Without this, every jacket is a
# slow authenticated GET to api.cloudflare.com (500–1000ms each)
CLOUDFLARE_R2_PUBLIC_BASE=https://r2.phiapi.miyuki-yue.dev
# Optional. Defaults to /tmp/phi-web-info (Vercel instance cache for catalog files)
# PHI_INFO_CACHE=/tmp/phi-web-info
# Chart levels: KV phi:infoFile (the csv + its sha) mounted over R2
# info/info.csv. phi-unpackd (../ill-sync-worker) writes both from the unpacked
# APK, with info/{notesInfo.json,tips.txt,avatar.txt} and the jackets; the
# ill-sync cron copies the rest of info/ from GitHub and writes _sync/info.json
# phib19 lookups (B30 tag analysis, peer averages, rank badges, aliases) go
# through the ill-sync Worker; to call phib19 directly instead:
# PHI_CHART_TAG_API=https://phib19.top:8080
# CN TapTap (tapapis.cn) is proxied too, override:
# TAP_PROXY_URL=off


# Shared secret for both Worker proxies (ill-sync `wrangler secret put PROXY_SECRET`)
# Without it the Worker refuses proxied requests
PHI_PROXY_KEY=

# Dev only (ignored when NODE_ENV=production). `pnpm dev:local` sets
# PHI_LOCAL_DATA=1: KV lives in memory, seeded with one bound user and the save
# in PHI_LOCAL_SAVE, so nothing is written to the shared namespace (R2 writes are
# off; jackets still load from CLOUDFLARE_R2_PUBLIC_BASE). Sign in without
# Discord by setting the cookie this prints:
#   node --env-file=.env.local --import tsx scripts/dev-session.ts [uid]
# PHI_LOCAL_DATA=1
# PHI_LOCAL_UID=local-dev
# PHI_LOCAL_SAVE=data/raw-save.json
#
# Offline card renders (no KV, R2 or Discord) from data/raw-save.json:
#   pnpm render-card <b30|x30|fc30|hisb30|song> [out.jpg]
# with STYLE=classic|table|portrait|timeline|summary, LOCALE=en|zh, and the other
# options listed at the top of scripts/render-card-local.ts
