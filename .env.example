AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=http://localhost:3000
# Extra origins so Discord OAuth returns to the host the user started on:
AUTH_URLS=https://phi.yuemiyuki.dev,https://phi-webui.vercel.app
AUTH_TRUST_HOST=true

# Cloudflare KV namespace shared with the Discord bot (same phi:* keys).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Defaults to ./phi-assets (HTML, fonts, song info).
# PHI_ASSETS=/absolute/path/to/phi-assets
# PHI_ILL=/absolute/path/to/illustration-pack

CLOUDFLARE_R2_BUCKET=phi-web-assets
# CLOUDFLARE_R2_ILL_PREFIX=original_ill
# CLOUDFLARE_R2_HTML_PREFIX=html
# CLOUDFLARE_R2_INFO_PREFIX=info
# Public R2 custom domain (TLS 1.3). Without this, every jacket is a
# slow authenticated GET to api.cloudflare.com (500–1000ms each).
CLOUDFLARE_R2_PUBLIC_BASE=https://r2.phiapi.miyuki-yue.dev
# Optional. Defaults to /tmp/phi-web-info (Vercel instance cache for catalog files).
# PHI_INFO_CACHE=/tmp/phi-web-info
# Chart levels come from phi:infoFile in this KV (written by ill-sync from
# https://phib19.top:8080/get/infoFile). Jackets come from R2.
# Live B30 tag analysis / per-song peer averages via cf, override:
# PHI_CHART_TAG_API=https://phib19.top:8080
# CN TapTap (tapapis.cn) is proxied too, override:
# TAP_PROXY_URL=off


# Shared secret for both Worker proxies (ill-sync `wrangler secret put PROXY_SECRET`).
# Without it the Worker refuses proxied requests.
PHI_PROXY_KEY=
