AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=http://localhost:3000
# Extra origins Discord OAuth may return to
AUTH_URLS=https://phibot.dev,https://pv.phibot.dev
AUTH_TRUST_HOST=true

# KV namespace shared with the Discord bot
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Optional, defaults to ./phi-assets
# PHI_ASSETS=/absolute/path/to/phi-assets
# PHI_ILL=/absolute/path/to/illustration-pack
# Override the app root that asset paths resolve from, defaults to the working directory
# PHI_APP_ROOT=

CLOUDFLARE_R2_BUCKET=phi-web-assets
# Public R2 domain: without it every jacket is a slow API read
CLOUDFLARE_R2_PUBLIC_BASE=https://r2.phibot.dev
# R2 through the S3 endpoint: a key pair with Object Read & Write on phi-web-assets and phi-web-cache
# Without it, R2 calls use CLOUDFLARE_API_TOKEN as before
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional, defaults to https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_S3_ENDPOINT=
# Optional, defaults to /tmp/phi-web-info
# PHI_INFO_CACHE=/tmp/phi-web-info
# Jacket cache directory, defaults to /tmp/phi-web-ill
# PHI_ILL_CACHE=
# Jacket cache size limit in MB, defaults to 128; the least recently used jackets are deleted past it
# PHI_ILL_CACHE_MB=
# Tag radar image directory, defaults to phi-tag-radar in the system temp folder
# PHI_RADAR_CACHE=
# phib19 goes through the ill-sync Worker; to call it directly:
# PHI_CHART_TAG_API=https://phib19.top:8080
# CN TapTap is proxied too; to turn that off:
# TAP_PROXY_URL=off
# Save files download only from hosts under these comma-separated suffixes; empty allows every https host name
# PHI_SAVE_HOSTS=

# Shared secret for both Worker proxies (ill-sync PROXY_SECRET)
PHI_PROXY_KEY=

# Phira multiplayer server (chorus) HTTP API token, for /phira-mp
PHIRA_MP_TOKEN=
# PHIRA_MP_API_URL=https://papi.phibot.dev

# Status API for /status, defaults to https://api.phibot.dev/uptime
# STATUS_API_URL=

# Dev only: `pnpm dev:local` sets PHI_LOCAL_DATA=1, an in-memory KV seeded from PHI_LOCAL_SAVE
# Session cookie: node --env-file=.env.local --import tsx scripts/dev-session.ts [uid]
# PHI_LOCAL_DATA=1
# PHI_LOCAL_UID=local-dev
# PHI_LOCAL_SAVE=data/raw-save.json
# Dev only: a save-history JSON for the in-memory store
# PHI_LOCAL_HISTORY=
#
# Offline renders: pnpm render-card <b30|x30|fc30|hisb30|song> [out.jpg], options in scripts/render-card-local.ts
#
# Discord user whose B30 is the default social preview image
# PHI_OG_UID=
#
# Year in review: next dev always shows /review; 1 opens it before 1 December on a preview (VERCEL_ENV=preview); never in production
# PHI_REVIEW_EARLY=
#
# Render-only routes under /render, used by the PV overlay tooling; on when set to 1
# PHI_RENDER=
# Font file the render-only routes serve
# PHI_RENDER_FONT=
