AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=http://localhost:3000
# Extra origins Discord OAuth may return to
AUTH_URLS=https://phi.yuemiyuki.dev,https://phi-webui.vercel.app,https://pv.phi.yuemiyuki.dev
AUTH_TRUST_HOST=true

# KV namespace shared with the Discord bot
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Optional, defaults to ./phi-assets
# PHI_ASSETS=/absolute/path/to/phi-assets
# PHI_ILL=/absolute/path/to/illustration-pack

CLOUDFLARE_R2_BUCKET=phi-web-assets
# CLOUDFLARE_R2_ILL_PREFIX=original_ill
# CLOUDFLARE_R2_HTML_PREFIX=html
# CLOUDFLARE_R2_INFO_PREFIX=info
# Public R2 domain: without it every jacket is a slow API read
CLOUDFLARE_R2_PUBLIC_BASE=https://r2.phiapi.miyuki-yue.dev
# Optional, defaults to /tmp/phi-web-info
# PHI_INFO_CACHE=/tmp/phi-web-info
# phib19 goes through the ill-sync Worker; to call it directly:
# PHI_CHART_TAG_API=https://phib19.top:8080
# CN TapTap is proxied too; to turn that off:
# TAP_PROXY_URL=off

# Shared secret for both Worker proxies (ill-sync PROXY_SECRET)
PHI_PROXY_KEY=

# Dev only: `pnpm dev:local` sets PHI_LOCAL_DATA=1, an in-memory KV seeded from PHI_LOCAL_SAVE
# Session cookie: node --env-file=.env.local --import tsx scripts/dev-session.ts [uid]
# PHI_LOCAL_DATA=1
# PHI_LOCAL_UID=local-dev
# PHI_LOCAL_SAVE=data/raw-save.json
#
# Offline renders: pnpm render-card <b30|x30|fc30|hisb30|song> [out.jpg], options in scripts/render-card-local.ts
#
# Discord user whose B30 is the default social preview image
# PHI_OG_UID=
