AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Cloudflare KV namespace shared with the Discord bot (same phi:* keys).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Defaults to ./phi-assets (HTML, fonts, song info).
# PHI_ASSETS=/absolute/path/to/phi-assets
# PHI_ILL=/absolute/path/to/illustration-pack

# Chart jackets: Cloudflare R2. Default bucket is phi-web-assets (same token as KV).
# Set CLOUDFLARE_R2_BUCKET= to disable R2 and use GitHub / PHI_ILL only.
CLOUDFLARE_R2_BUCKET=phi-web-assets
# CLOUDFLARE_R2_ILL_PREFIX=original_ill
# Optional public base (r2.dev or custom domain) so GET does not need the API token:
# CLOUDFLARE_R2_PUBLIC_BASE=https://pub-xxxxx.r2.dev
